package murmur:host@0.1.0;

world runtime-host {
  import murmur:artifact-manager/manage@0.1.0;
  import murmur:shell/execute@0.1.0;
  import murmur:tool-registry/invoke@0.2.0;
  import murmur:message/send@0.1.0;
}

/// The interfaces the runtime provides to a WASM tool's own store, beyond the ones registered by
/// hand in `invoke_tool_component`.
world tool-host {
  import murmur:process/process@0.2.0;
}

/// The interface the runtime provides to the code mode tool's instance, beyond the `tool-host`
/// ones, and only to the artifact `code_mode.repl` names.
world code-mode-host {
  import murmur:bus/bus@0.1.0;
}
