package murmur:hook@0.6.0;

interface lifecycle {
    record message {
        role: string,
        content: string,
        /// Stable identity for this message, minted by the runtime as `msg_`
        /// followed by a uuid-v7 simple form. A uuid-v7 carries its own
        /// millisecond timestamp, so there is no separate `created-at` field to
        /// keep in step with it.
        ///
        /// This is **not** a content hash. An id must never repeat, even for two
        /// messages whose content is byte-identical; a content hash must repeat
        /// whenever the content does. The two answer different questions and are
        /// never interchangeable.
        ///
        /// Stripped before the wire payload is built — see the note on
        /// `source-id`. The runtime mints one for every message it builds out of
        /// a hook-returned message list, so an id set on a message a hook returns
        /// is replaced rather than kept: identity belongs to whoever put the
        /// message in the context.
        id: option<string>,
        /// Opaque join key back to whatever produced this content — a corpus
        /// record, a compaction summary, reloaded history. Recorded verbatim and
        /// never parsed, exactly like `resource-id` in tool metadata: the runtime
        /// makes no claim about its shape and reads no meaning out of it.
        ///
        /// Both `id` and `source-id` are stripped before the driver wire payload
        /// is built. A uuid sitting at the head of a cached prefix is volatile
        /// content, and would defeat provider prompt-prefix caching on every
        /// request. A `source-id` a hook supplies is carried verbatim; the key is
        /// absent when the hook supplied none.
        source-id: option<string>,
    }

    record tool-manifest {
        binary-name: string,
        content: string,
    }

    variant hook-output {
        none,
        replace-context(list<message>),
        write-manifests(list<tool-manifest>),
        /// Emit a structured artifact payload to the SSE event stream.
        /// The string must be a valid JSON object.
        artifact(string),
        /// Control decision honored only at `on-task-end`: do not finalize the
        /// task, re-run its agent loop with `reason` injected into the task
        /// content as feedback, then let this hook re-inspect the result. Bounded
        /// by the capsule's `lifecycle.max_task_reopens` budget and its
        /// `inference.max_turns` ceiling. Returned from any other lifecycle event
        /// it is a non-fatal dispatch fault (logged and traced, never honored).
        reopen-task(string),
        /// Context to seed a task with, distinct from `replace-context` because
        /// seeding needs a ceiling and compaction must not have one: compaction's
        /// contract is that the hook has already done the shrinking, so the host
        /// takes what it is handed. A seed is proposed against a budget the host
        /// enforces.
        ///
        /// Honored only at `on-task-start`, where the first bound blocking hook to
        /// return it wins and its messages are placed at the head of the task's
        /// context — ahead of any loaded history and ahead of the task message.
        /// The list is chronological, oldest first, which is what makes the
        /// runtime's "drop from the front" trim well-defined. Returned from any
        /// other lifecycle event it is a non-fatal dispatch fault (logged and
        /// traced, never honored).
        ///
        /// The host measures the proposal against `task-start-event.budget-tokens`
        /// and may commit it whole, trim its oldest messages away, summarize the
        /// overflowing front through the compaction hook, or refuse it entirely.
        /// A refusal never fails the task.
        seed-context(list<message>),
    }

    record session-context {
        capsule-name: string,
        capsule-version: string,
        session-id: string,
        model: string,
        capabilities: list<string>,
    }

    record stage-event {
        shell-allow: list<string>,
    }

    record task-start-event {
        task-id: string,
        context-id: string,
        source: string,
        input-bytes: u64,
        /// Token ceiling a hook may propose context up to for this task:
        /// `context.max_tokens` times `context.seed_budget`, rounded down. Read
        /// `0` as "the host has not computed this" and decline, never as an
        /// unbounded budget — a capsule declaring no `context.max_tokens` sends
        /// `0` and refuses any seed returned against it.
        budget-tokens: u64,
        /// The capsule's `context.max_tokens`, or `0` when the manifest declares
        /// none. Precomputed by the host so a hook measuring against the window
        /// never has to know which model the session runs or how wide its window
        /// is.
        context-window: u64,
        /// Tokens already occupied by context the host loaded before this task's
        /// first turn: the conversation history a capsule running
        /// `lifecycle.conversation: threaded` will start from, and `0` under every
        /// other conversation mode. The same "`0` means not computed" reading
        /// applies as for `budget-tokens`. Without it a hook seeding into a
        /// threaded context duplicates history it cannot otherwise see.
        prior-tokens: u64,
    }

    record task-end-event {
        task-id: string,
        exit-status: string,
    }

    record inference-event {
        turn: u32,
        input-tokens: u64,
        output-tokens: u64,
        decision: string,
        tool-name: option<string>,
        prompt: option<string>,
        output: option<string>,
        tools: option<string>,
    }

    record tool-event {
        turn: u32,
        tool-name: string,
        input-bytes: u64,
        output-bytes: u64,
        duration-ms: u64,
        status: string,
    }

    record shell-event {
        turn: u32,
        /// The program that was actually invoked, as a canonicalized absolute
        /// filesystem path when the host could resolve the invoked name against
        /// its `PATH` at dispatch time (e.g. `/usr/bin/pytest`). Falls back to
        /// the bare invoked name when resolution finds nothing — never empty,
        /// never an error. This is the only field that identifies *what ran*;
        /// `command` carries the argument list alone.
        binary: string,
        /// The argument list the shell tool received — never the binary name
        /// itself. For a shell interpreter (`bash`/`sh`/...) this is the script
        /// text passed via `-c`.
        command: string,
        exit-code: s32,
        stdout: string,
        stderr: string,
        stdout-bytes: u64,
        stderr-bytes: u64,
        duration-ms: u64,
    }

    record compaction-event {
        messages: list<message>,
        session-tokens: u64,
        threshold: f64,
        /// Model the hook should use for its summarization call, when the
        /// manifest configures one. `none` = use the capsule's primary
        /// `inference.model`. Always `none` today; populated by a later slice.
        model: option<string>,
        /// System prompt override for the hook's summarization call. `none` =
        /// the hook's own built-in prompt. Always `none` today; populated by a
        /// later slice.
        system-prompt: option<string>,
    }

    record session-end-event {
        total-turns: u32,
        total-input-tokens: u64,
        total-output-tokens: u64,
        total-tool-calls: u32,
        total-shell-calls: u32,
        duration-ms: u64,
        exit-status: string,
    }

    on-stage: func(event: stage-event) -> result<hook-output, string>;
    on-session-start: func(ctx: session-context) -> result<hook-output, string>;
    on-task-start: func(event: task-start-event) -> result<hook-output, string>;
    on-inference: func(event: inference-event) -> result<hook-output, string>;
    on-tool-call: func(event: tool-event) -> result<hook-output, string>;
    on-shell: func(event: shell-event) -> result<hook-output, string>;
    on-compaction: func(event: compaction-event) -> result<hook-output, string>;
    on-task-end: func(event: task-end-event) -> result<hook-output, string>;
    on-session-end: func(event: session-end-event) -> result<hook-output, string>;
}
