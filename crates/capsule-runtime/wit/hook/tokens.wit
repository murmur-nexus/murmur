package murmur:runtime@0.4.0;

/// Host-provided token counter available to any hook component.
///
/// Counting text is pure computation: no side effect, no host resource, no
/// filesystem or network reach. The import is therefore ungated — no capability
/// grant enables it and none can withhold it.
interface tokens {
    /// The host's own `cl100k_base` count of `text`.
    ///
    /// The same counter behind the host's own estimates: a request's size
    /// before it is sent, a seed's budget, and the compaction trigger when the
    /// driver reported no usage. Once a driver reports usage, the compaction
    /// trigger and the spend meter use the provider's count instead, which no
    /// local tokenizer reproduces. A hook that brings its own tokenizer is
    /// measuring something the host does not.
    count: func(text: string) -> u64;
}
