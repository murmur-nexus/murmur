#!/bin/bash
# A fake harness for the process driver runner's integration tests. It speaks the fixture process
# driver's toy line format (see ../README.md) and does whatever $FIXTURE_HARNESS_PROFILE says.
#
# Its environment is exactly what the capsule's `capabilities.env.allow` declared plus the driver's
# `env-set`, so tests that use `sleep`, `ls` or `env` have to declare PATH.

set -u

if [ "${1:-}" = "--version" ]; then
  if [ "${FIXTURE_HARNESS_PROFILE:-}" = "old-version" ]; then
    echo "fixture-harness 0.9.0"
  else
    echo "fixture-harness 1.0.0"
  fi
  exit 0
fi

# The driver puts the session on the harness's own command line, which is where a profile with a
# memory of its own reads it: `--session <id> --mode new|resume`, plus `--model <m>` when set.
SESSION=""
MODE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session) SESSION="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done

# Profiles a test must prove dead leave their pid where the test can read it.
record_pid() { echo $$ > harness.pid; }

# The `memory` profiles keep one file per session here — the harness's own store, which is not
# murmur's map and which a test deletes to make a resume fail.
SESSION_STORE="${HOME:-.}/fake-harness-sessions"

# Every task line this session has been told, on one line.
recall() { tr '\n' ' ' < "$SESSION_STORE/$1"; }

# One `tools/call` against the bridge, over bash's own /dev/tcp — no curl in the environment.
# Takes the tool's bare name and its arguments as JSON, both defaulting to the echo tool's ping.
# Prints the response body on one line.
call_bridge() {
  local tool="${1:-echo-tool}" args="${2:-}" host_port path body request line
  [ -n "$args" ] || args='{"msg":"ping-7"}'
  host_port="${FIXTURE_BRIDGE_URL#http://}"
  path="/${host_port#*/}"
  host_port="${host_port%%/*}"
  body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$tool\",\"arguments\":$args}}"
  exec 3<>"/dev/tcp/${host_port%%:*}/${host_port##*:}"
  printf 'POST %s HTTP/1.1\r\n' "$path" >&3
  printf 'Host: %s\r\n' "$host_port" >&3
  printf 'Authorization: Bearer %s\r\n' "$FIXTURE_BRIDGE_TOKEN" >&3
  printf 'Content-Type: application/json\r\n' >&3
  printf 'Content-Length: %s\r\n' "${#body}" >&3
  printf 'Connection: close\r\n\r\n' >&3
  printf '%s' "$body" >&3
  # Skip the status line and headers, then print what is left on one line. The body carries no
  # trailing newline, so it is read with `-d ''` (up to a NUL, i.e. to EOF) rather than by lines.
  while IFS= read -r line <&3; do
    line="${line%$'\r'}"
    [ -z "$line" ] && break
  done
  request=""
  IFS= read -r -d '' request <&3 || true
  exec 3<&-
  echo "${request//$'\n'/}"
}

# The task arrives as one line on stdin.
read -r TASK || TASK=""

case "${FIXTURE_HARNESS_PROFILE:-happy}" in
  happy)
    echo "started fixture-session-1"
    echo "text HAPPY-RESULT"
    echo "end HAPPY-RESULT"
    ;;
  tool)
    echo "started fixture-session-1"
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"ping-7\"}"
    answer="$(call_bridge)"
    echo "result c1 ok $answer"
    echo "text $answer"
    echo "end $answer"
    ;;
  fail-auth|fail-quota|fail-max-turns|fail-canceled|fail-harness-error|fail-other)
    echo "started fixture-session-1"
    echo "fail ${FIXTURE_HARNESS_PROFILE#fail-} the harness says so"
    ;;
  exit-0)
    echo "started fixture-session-1"
    echo "text no terminal event here"
    exit 0
    ;;
  exit-3)
    echo "started fixture-session-1"
    echo "boom-on-stderr" >&2
    exit 3
    ;;
  silent)
    record_pid
    echo "started fixture-session-1"
    sleep 600
    ;;
  chatty)
    # Outlives the debug inactivity window several times over, saying something each time.
    echo "started fixture-session-1"
    for i in 1 2 3 4 5 6; do
      echo "note tick $i"
      sleep 0.5
    done
    echo "end CHATTY-RESULT"
    ;;
  bridge-call)
    # One bridged call per FIXTURE_BRIDGE_CALLS (default one), with whatever tool and arguments
    # FIXTURE_BRIDGE_CALL_TOOL and FIXTURE_BRIDGE_CALL_ARGS name. An `isError` answer is reported
    # as a failed tool result, which is what a harness told no does with one.
    echo "started fixture-session-1"
    CALL_TOOL="${FIXTURE_BRIDGE_CALL_TOOL:-}"
    CALL_ARGS="${FIXTURE_BRIDGE_CALL_ARGS:-}"
    [ -n "$CALL_ARGS" ] || CALL_ARGS='{"msg":"ping-7"}'
    # The `tool` line carries the qualified <server>__<tool> spelling, the bridge call the bare
    # one. Match them: taking the first advertised tool would mislabel the call for any capsule
    # declaring more than one.
    QUALIFIED="${FIXTURE_BRIDGE_TOOLS%%,*}"
    for candidate in $(printf '%s' "$FIXTURE_BRIDGE_TOOLS" | tr ',' ' '); do
      case "$candidate" in
        *"__$CALL_TOOL") QUALIFIED="$candidate"; break ;;
      esac
    done
    i=1
    while [ "$i" -le "${FIXTURE_BRIDGE_CALLS:-1}" ]; do
      echo "tool c$i $QUALIFIED $CALL_ARGS"
      answer="$(call_bridge "$CALL_TOOL" "$CALL_ARGS")"
      case "$answer" in
        *'"isError":true'*) status=error ;;
        *) status=ok ;;
      esac
      echo "result c$i $status $answer"
      i=$((i + 1))
    done
    echo "text $answer"
    echo "end $answer"
    ;;
  bridge-bench)
    # FIXTURE_BRIDGE_CALLS bridged calls back to back and one turn around all of them, so a test
    # can time the same run with and without a decision point in the way.
    echo "started fixture-session-1"
    i=1
    while [ "$i" -le "${FIXTURE_BRIDGE_CALLS:-20}" ]; do
      answer="$(call_bridge)"
      i=$((i + 1))
    done
    echo "text $answer"
    echo "end $answer"
    ;;
  bridge-busy)
    # Says nothing on stdout while it works, and keeps the bridge busy instead.
    echo "started fixture-session-1"
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"ping-7\"}"
    for i in 1 2 3 4 5 6; do
      answer="$(call_bridge)"
      sleep 0.5
    done
    echo "result c1 ok $answer"
    echo "end BRIDGE-BUSY-RESULT"
    ;;
  env)
    echo "started fixture-session-1"
    echo "env $(env | cut -d= -f1 | sort | tr '\n' ',')"
    echo "files $(ls -ld "$FIXTURE_FILES" | cut -d' ' -f1) $FIXTURE_FILES"
    echo "end ENV-RESULT"
    ;;
  old-version)
    echo "started fixture-session-1"
    echo "end OLD-VERSION-RESULT"
    ;;
  turns)
    # Three turns: two closed by a tool result, the third opened by text.
    echo "started fixture-session-1"
    echo "tool c1 probe {}"
    echo "result c1 ok one"
    echo "tool c2 probe {}"
    echo "result c2 ok two"
    record_pid
    echo "text three"
    sleep 30
    ;;
  thinking)
    # Thinking and deltas must not open a turn: one turn, one inference record.
    echo "started fixture-session-1"
    echo "thinking pondering"
    echo "delta par"
    echo "delta tial"
    echo "thinking still pondering"
    echo "text THINKING-RESULT"
    echo "end THINKING-RESULT"
    ;;
  api-key)
    echo "started fixture-session-1 api-key"
    echo "end API-KEY-RESULT"
    ;;
  memory|memory-renames)
    # A task that arrived over A2A is fenced, so the payload is several lines rather than one.
    # Read to the closing marker — which is already on stdin, so nothing here waits on the runtime,
    # which keeps the handle open after writing.
    case "$TASK" in
      '<untrusted-content'*)
        FENCED=""
        while IFS= read -r line; do
          [ "$line" = "</untrusted-content>" ] && break
          FENCED="$FENCED$line "
        done
        TASK="$FENCED"
        ;;
    esac
    # On a new session the harness picks the id it will answer to; under `memory` that is the one
    # it was handed, and under `memory-renames` it is one of its own, reported back on `started`.
    if [ "$MODE" = "resume" ]; then
      if [ ! -f "$SESSION_STORE/$SESSION" ]; then
        echo "fail harness-error no conversation found with session id $SESSION"
        exit 1
      fi
      echo "started $SESSION"
      printf '%s\n' "$TASK" >> "$SESSION_STORE/$SESSION"
      echo "end $(recall "$SESSION")"
    else
      if [ "${FIXTURE_HARNESS_PROFILE:-}" = "memory-renames" ]; then
        REPORTED="renamed-$SESSION"
      else
        REPORTED="$SESSION"
      fi
      mkdir -p "$SESSION_STORE"
      printf '%s\n' "$TASK" > "$SESSION_STORE/$REPORTED"
      echo "started $REPORTED"
      echo "end $(recall "$REPORTED")"
    fi
    ;;
  parity)
    # The http capsule's provider script, in harness events: one turn that says something and
    # calls a tool, then one that answers. Its A2A frames must match that capsule's exactly.
    echo "started s1 subscription"
    echo "text working on it"
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"ping\"}"
    answer="$(call_bridge)"
    echo "result c1 ok $answer"
    echo "text PARITY-ANSWER"
    echo "end PARITY-ANSWER"
    ;;
  stream)
    # The streaming-driver fixture's three chunks, in harness events.
    echo "started s1 subscription"
    echo "delta chunk_one "
    echo "delta chunk_two "
    echo "delta chunk_three"
    echo "text chunk_one chunk_two chunk_three"
    echo "end chunk_one chunk_two chunk_three"
    ;;
  think)
    echo "started s1 subscription"
    echo "tdelta step "
    echo "tdelta one"
    echo "thinking step one"
    echo "text done"
    echo "end DONE"
    ;;
  think-whole)
    echo "started s1 subscription"
    echo "thinking whole thought"
    echo "text done"
    echo "end DONE"
    ;;
  interrupt-honours)
    # Honours a stdin interrupt: keeps reading stdin and stops the moment the runtime writes the
    # driver's interrupt bytes, reporting the turn the way a stopped harness does.
    record_pid
    echo "started fixture-session-1"
    while IFS= read -r line; do
      if [ "$line" = "interrupt" ]; then
        echo "fail canceled interrupted by the runtime"
        exit 0
      fi
    done
    ;;
  interrupt-ignores)
    # Never reads its stdin and never stops on its own, so the interrupt grace has to run out and
    # the runtime has to kill it.
    record_pid
    echo "started fixture-session-1"
    sleep 600
    ;;
  interrupt-signal)
    # Stops on SIGINT, reporting the turn as canceled before it goes.
    record_pid
    echo "started fixture-session-1"
    trap 'echo "fail canceled interrupted by SIGINT"; kill $SLEEP_PID 2>/dev/null; exit 0' INT
    sleep 600 &
    SLEEP_PID=$!
    wait $SLEEP_PID
    ;;
  linger)
    # Prints its terminal event and then ignores stdin closing, so the exit grace has to kill it.
    record_pid
    echo "started fixture-session-1"
    echo "end LINGER"
    sleep 60
    ;;
  *)
    echo "fail other unknown profile ${FIXTURE_HARNESS_PROFILE:-}"
    ;;
esac
