#!/bin/bash
# A fake harness for the process driver runner's integration tests. It speaks the fixture process
# driver's toy line format (see ../README.md) and does whatever $FIXTURE_HARNESS_PROFILE says.
#
# Its environment is exactly what the capsule's `capabilities.env.allow` declared plus the driver's
# `env-set`. It runs under the capsule's class, which lets it exec bash (its `#!` interpreter) and
# whatever `capabilities.shell.allow` grants, so every profile but `env` and `account` uses bash
# builtins alone; those two run `env`, `ls`, `cut`, `sort` and `tr`, which a test must declare PATH
# for and allow.

set -u

# The login check the driver's `describe()` names: one JSON line, and exit 0 whatever the answer,
# so only what it printed says whether it is logged in. The `token` field stands in for the account
# details a real harness prints, so a test can prove doctor never shows this output.
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
  case "${FIXTURE_HARNESS_PROFILE:-}" in
    logged-out) echo '{"loggedIn": false, "token": "fixture-secret-0d1e2f"}' ;;
    login-unreadable) echo 'not json' ;;
    *) echo '{"loggedIn": true}' ;;
  esac
  exit 0
fi

if [ "${1:-}" = "--version" ]; then
  if [ "${FIXTURE_HARNESS_PROFILE:-}" = "old-version" ]; then
    echo "fixture-harness 0.9.0"
  else
    echo "fixture-harness 1.0.0"
  fi
  exit 0
fi

# The driver puts the session on the harness's own command line, which is where a profile with a
# memory of its own reads it: `--session <id> --mode new|resume`, plus `--model <m>` when set.
SESSION=""
MODE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session) SESSION="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done

# Profiles a test must prove dead leave their pid where the test can read it.
record_pid() { echo $$ > harness.pid; }

# A sleep with no program behind it: `read` times out on a pipe nothing writes to.
pause() { read -r -t "$1" <> <(:) || true; }

# The store's folder, made only when it is not there: `mkdir` is a program, which a capsule whose
# test pre-creates the store does not have to allow.
ensure_store() { [ -d "$SESSION_STORE" ] || mkdir -p "$SESSION_STORE"; }

# The `memory` profiles keep one file per session here — the harness's own store, which is not
# murmur's map and which a test deletes to make a resume fail.
SESSION_STORE="${HOME:-.}/fake-harness-sessions"

# Every task line this session has been told, on one line.
recall() {
  local lines
  mapfile -t lines < "$SESSION_STORE/$1"
  printf '%s ' "${lines[@]}"
}

# A task that arrived over A2A is fenced, so the payload is several lines rather than one. Read to
# the closing marker — which is already on stdin, so nothing here waits on the runtime, which keeps
# the handle open after writing.
unfence_task() {
  case "$TASK" in
    '<untrusted-content'*)
      local fenced="" line
      while IFS= read -r line; do
        [ "$line" = "</untrusted-content>" ] && break
        fenced="$fenced$line "
      done
      TASK="$fenced"
      ;;
  esac
}

# Wait for the runtime's stdin interrupt and report the turn the way a stopped harness does. The
# profiles that use it produce a fixed amount of output, then a `note` — which is not work, and
# whose trace record is how a test knows the runtime has already read the work before it — and
# then hold the turn open, so a test can cancel at a known point.
await_interrupt() {
  local line
  while IFS= read -r line; do
    if [ "$line" = "interrupt" ]; then
      echo "fail canceled interrupted by the runtime"
      exit 0
    fi
  done
}

# One `tools/call` against the bridge, over bash's own /dev/tcp — no curl in the environment.
# Takes the tool's bare name and its arguments as JSON, both defaulting to the echo tool's ping.
# Prints the response body on one line.
call_bridge() {
  local tool="${1:-echo-tool}" args="${2:-}" host_port path body request line
  [ -n "$args" ] || args='{"msg":"ping-7"}'
  host_port="${FIXTURE_BRIDGE_URL#http://}"
  path="/${host_port#*/}"
  host_port="${host_port%%/*}"
  body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$tool\",\"arguments\":$args}}"
  exec 3<>"/dev/tcp/${host_port%%:*}/${host_port##*:}"
  printf 'POST %s HTTP/1.1\r\n' "$path" >&3
  printf 'Host: %s\r\n' "$host_port" >&3
  printf 'Authorization: Bearer %s\r\n' "$FIXTURE_BRIDGE_TOKEN" >&3
  printf 'Content-Type: application/json\r\n' >&3
  printf 'Content-Length: %s\r\n' "${#body}" >&3
  printf 'Connection: close\r\n\r\n' >&3
  printf '%s' "$body" >&3
  # Skip the status line and headers, then print what is left on one line. The body carries no
  # trailing newline, so it is read with `-d ''` (up to a NUL, i.e. to EOF) rather than by lines.
  while IFS= read -r line <&3; do
    line="${line%$'\r'}"
    [ -z "$line" ] && break
  done
  request=""
  IFS= read -r -d '' request <&3 || true
  exec 3<&-
  echo "${request//$'\n'/}"
}

# Whether a TCP connection to $1:$2 opens, over bash's /dev/tcp, within five seconds: OK, FAIL
# (refused or unreachable) or TIMEOUT. The attempt runs in a subshell of its own, so a connect that
# hangs is killed rather than holding the turn.
try_connect() {
  local out="connect-$1-$2.out" pid i
  rm_builtin "$out"
  ( { exec 3<>"/dev/tcp/$1/$2"; } 2>/dev/null && echo OK > "$out" || echo FAIL > "$out" ) &
  pid=$!
  for ((i = 0; i < 50; i++)); do
    kill -0 "$pid" 2>/dev/null || break
    pause 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    echo TIMEOUT
    return
  fi
  wait "$pid" 2>/dev/null
  local result=""
  [ -f "$out" ] && result="$(<"$out")"
  echo "${result:-FAIL}"
}

# Empties a file with a redirection, `rm` being a program.
rm_builtin() { : > "$1"; }

# The task arrives as one line on stdin.
read -r TASK || TASK=""

case "${FIXTURE_HARNESS_PROFILE:-happy}" in
  happy)
    echo "started fixture-session-1"
    echo "text HAPPY-RESULT"
    echo "end HAPPY-RESULT"
    ;;
  usage)
    # Every `usage` line is the cumulative total for the run so far, which is what the interface
    # asks for: the second names the same input as the first, so only the output grew.
    echo "started fixture-session-1"
    echo "usage in=120 out=4 cache-read=900 cache-creation=64 thinking=2"
    echo "text USAGE-RESULT"
    echo "usage in=120 out=30"
    echo "end USAGE-RESULT"
    ;;
  usage-zero)
    # A harness that reports having spent nothing. The trace must say `0`, not say nothing.
    echo "started fixture-session-1"
    echo "usage in=0 out=0"
    echo "text ZERO-RESULT"
    echo "end ZERO-RESULT"
    ;;
  usage-turns)
    # Two turns, each with its own cumulative report: the second turn is charged the growth
    # alone. Totals end at in=100 out=50.
    echo "started fixture-session-1"
    echo "usage in=40 out=20"
    echo "tool c1 probe {}"
    echo "result c1 ok one"
    echo "usage in=100 out=50"
    echo "text two"
    echo "end TURNS-RESULT"
    ;;
  usage-spends)
    # Enough on one turn to cross a small ceiling, so a test can watch the run stop.
    echo "started fixture-session-1"
    record_pid
    echo "usage in=5000 out=5000"
    echo "text SPENT"
    echo "end SPENT"
    pause 60
    ;;
  tool)
    echo "started fixture-session-1"
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"ping-7\"}"
    answer="$(call_bridge)"
    echo "result c1 ok $answer"
    echo "text $answer"
    echo "end $answer"
    ;;
  fail-auth|fail-quota|fail-max-turns|fail-canceled|fail-harness-error|fail-other)
    echo "started fixture-session-1"
    echo "fail ${FIXTURE_HARNESS_PROFILE#fail-} the harness says so"
    ;;
  text-then-fail)
    # A turn that opens with text and then fails, so the turn `fail` closes has run its
    # `on-inference` hooks.
    echo "started fixture-session-1"
    echo "text PARTIAL"
    echo "fail other the harness says so"
    ;;
  exit-0)
    echo "started fixture-session-1"
    echo "text no terminal event here"
    exit 0
    ;;
  exit-3)
    echo "started fixture-session-1"
    echo "boom-on-stderr" >&2
    exit 3
    ;;
  silent)
    record_pid
    echo "started fixture-session-1"
    pause 600
    ;;
  chatty)
    # Outlives the debug inactivity window several times over, saying something each time.
    echo "started fixture-session-1"
    for i in 1 2 3 4 5 6; do
      echo "note tick $i"
      pause 0.5
    done
    echo "end CHATTY-RESULT"
    ;;
  bridge-call)
    # One bridged call per FIXTURE_BRIDGE_CALLS (default one), with whatever tool and arguments
    # FIXTURE_BRIDGE_CALL_TOOL and FIXTURE_BRIDGE_CALL_ARGS name. An `isError` answer is reported
    # as a failed tool result, which is what a harness told no does with one.
    echo "started fixture-session-1"
    CALL_TOOL="${FIXTURE_BRIDGE_CALL_TOOL:-}"
    CALL_ARGS="${FIXTURE_BRIDGE_CALL_ARGS:-}"
    [ -n "$CALL_ARGS" ] || CALL_ARGS='{"msg":"ping-7"}'
    # The `tool` line carries the qualified <server>__<tool> spelling, the bridge call the bare
    # one. Match them: taking the first advertised tool would mislabel the call for any capsule
    # declaring more than one.
    QUALIFIED="${FIXTURE_BRIDGE_TOOLS%%,*}"
    for candidate in ${FIXTURE_BRIDGE_TOOLS//,/ }; do
      case "$candidate" in
        *"__$CALL_TOOL") QUALIFIED="$candidate"; break ;;
      esac
    done
    i=1
    while [ "$i" -le "${FIXTURE_BRIDGE_CALLS:-1}" ]; do
      echo "tool c$i $QUALIFIED $CALL_ARGS"
      answer="$(call_bridge "$CALL_TOOL" "$CALL_ARGS")"
      case "$answer" in
        *'"isError":true'*) status=error ;;
        *) status=ok ;;
      esac
      echo "result c$i $status $answer"
      i=$((i + 1))
    done
    echo "text $answer"
    echo "end $answer"
    ;;
  session-status)
    # Three turns, each calling `session-status` through the bridge and keeping what it was
    # handed in status-<n>.answer. Turn 1 reports usage before its call, so the second call sees
    # one closed turn; the third waits FIXTURE_STATUS_WAIT seconds first.
    echo "started fixture-session-1"
    QUALIFIED=""
    for candidate in ${FIXTURE_BRIDGE_TOOLS//,/ }; do
      case "$candidate" in
        *__session-status) QUALIFIED="$candidate" ;;
      esac
    done
    echo "usage in=40 out=20 cache-read=100 cache-creation=10"
    for i in 1 2 3; do
      if [ "$i" -eq 3 ]; then
        pause "${FIXTURE_STATUS_WAIT:-0}"
      fi
      echo "tool c$i $QUALIFIED {}"
      answer="$(call_bridge session-status '{}')"
      printf '%s\n' "$answer" > "status-$i.answer"
      echo "result c$i ok status $i"
      # The runtime closes the turn on the result line; give it the moment it takes to read it.
      pause 1
      if [ "$i" -eq 1 ]; then
        echo "usage in=100 out=50"
      fi
    done
    echo "text STATUS-RESULT"
    echo "end STATUS-RESULT"
    ;;
  bridge-bench)
    # FIXTURE_BRIDGE_CALLS bridged calls back to back and one turn around all of them, so a test
    # can time the same run with and without a decision point in the way.
    echo "started fixture-session-1"
    i=1
    while [ "$i" -le "${FIXTURE_BRIDGE_CALLS:-20}" ]; do
      answer="$(call_bridge)"
      i=$((i + 1))
    done
    echo "text $answer"
    echo "end $answer"
    ;;
  bridge-parallel)
    # A long shell call on its own connection, and a quick tool call on another while it runs. The
    # quick one's `result` line comes first when the bridge serves the two concurrently. The wait
    # is a bash builtin: the shell tool's sandbox does not let it exec `/usr/bin/sleep`.
    echo "started fixture-session-1"
    BASH_TOOL="" ECHO_TOOL=""
    for candidate in ${FIXTURE_BRIDGE_TOOLS//,/ }; do
      case "$candidate" in
        *__bash) BASH_TOOL="$candidate" ;;
        *__echo-tool) ECHO_TOOL="$candidate" ;;
      esac
    done
    echo "tool c1 $BASH_TOOL {\"command\":\"read -t 8 <> <(:)\"}"
    ( call_bridge bash '{"command":"read -t 8 <> <(:)"}' > parallel-c1.answer ) &
    pause 0.5
    echo "tool c2 $ECHO_TOOL {\"msg\":\"ping-7\"}"
    answer="$(call_bridge)"
    echo "result c2 ok $answer"
    wait
    echo "result c1 ok $(<parallel-c1.answer)"
    echo "end PARALLEL-RESULT"
    ;;
  bridge-busy)
    # Says nothing on stdout while it works, and keeps the bridge busy instead.
    echo "started fixture-session-1"
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"ping-7\"}"
    for i in 1 2 3 4 5 6; do
      answer="$(call_bridge)"
      pause 0.5
    done
    echo "result c1 ok $answer"
    echo "end BRIDGE-BUSY-RESULT"
    ;;
  env)
    echo "started fixture-session-1"
    echo "env $(env | cut -d= -f1 | sort | tr '\n' ',')"
    echo "files $(ls -ld "$FIXTURE_FILES" | cut -d' ' -f1) $FIXTURE_FILES"
    echo "end ENV-RESULT"
    ;;
  account)
    # `${VAR-unset}`: a variable set to the empty string prints empty, not `unset`.
    echo "started fixture-session-1"
    echo "account USER=${USER-unset} LOGNAME=${LOGNAME-unset}"
    echo "env $(env | cut -d= -f1 | sort | tr '\n' ',')"
    echo "end ACCOUNT-RESULT"
    ;;
  old-version)
    echo "started fixture-session-1"
    echo "end OLD-VERSION-RESULT"
    ;;
  turns)
    # Three turns: two closed by a tool result, the third opened by text.
    echo "started fixture-session-1"
    echo "tool c1 probe {}"
    echo "result c1 ok one"
    echo "tool c2 probe {}"
    echo "result c2 ok two"
    record_pid
    echo "text three"
    pause 30
    ;;
  thinking)
    # Thinking and deltas must not open a turn: one turn, one inference record.
    echo "started fixture-session-1"
    echo "thinking pondering"
    echo "delta par"
    echo "delta tial"
    echo "thinking still pondering"
    echo "text THINKING-RESULT"
    echo "end THINKING-RESULT"
    ;;
  api-key)
    echo "started fixture-session-1 api-key"
    echo "end API-KEY-RESULT"
    ;;
  memory|memory-renames)
    unfence_task
    # On a new session the harness picks the id it will answer to; under `memory` that is the one
    # it was handed, and under `memory-renames` it is one of its own, reported back on `started`.
    if [ "$MODE" = "resume" ]; then
      if [ ! -f "$SESSION_STORE/$SESSION" ]; then
        echo "fail harness-error no conversation found with session id $SESSION"
        exit 1
      fi
      echo "started $SESSION"
      printf '%s\n' "$TASK" >> "$SESSION_STORE/$SESSION"
      echo "end $(recall "$SESSION")"
    else
      if [ "${FIXTURE_HARNESS_PROFILE:-}" = "memory-renames" ]; then
        REPORTED="renamed-$SESSION"
      else
        REPORTED="$SESSION"
      fi
      ensure_store
      printf '%s\n' "$TASK" > "$SESSION_STORE/$REPORTED"
      echo "started $REPORTED"
      echo "end $(recall "$REPORTED")"
    fi
    ;;
  memory-silent)
    # Names the session it was handed and then produces nothing at all: no text, no thinking, no
    # tool call, and no entry in its own store. A cancel here lands inside the window where the
    # harness has a name and no conversation.
    record_pid
    echo "started $SESSION"
    await_interrupt
    ;;
  memory-slow)
    # Opens a conversation of its own, says one thing, and then holds the turn open. A cancel here
    # lands after real output, on a session the harness will answer to again.
    record_pid
    unfence_task
    ensure_store
    printf '%s\n' "$TASK" > "$SESSION_STORE/$SESSION"
    echo "started $SESSION"
    echo "text SLOW-PARTIAL"
    echo "note the work above is out"
    await_interrupt
    ;;
  memory-thinking-only)
    # As memory-slow, with a thought in place of the text: thinking alone is work the harness
    # produced.
    record_pid
    unfence_task
    ensure_store
    printf '%s\n' "$TASK" > "$SESSION_STORE/$SESSION"
    echo "started $SESSION"
    echo "thinking pondering the secret"
    echo "note the work above is out"
    await_interrupt
    ;;
  memory-tool-only)
    # As memory-slow, with a tool call in place of the text. The call is never answered and the
    # tool is never reached: what the runtime saw is the call itself.
    record_pid
    unfence_task
    ensure_store
    printf '%s\n' "$TASK" > "$SESSION_STORE/$SESSION"
    echo "started $SESSION"
    echo "tool c1 probe {}"
    echo "note the work above is out"
    await_interrupt
    ;;
  member-call)
    # A formation lead. On a new session it hands worker one task through the bridged
    # `call-member`, keeps the bridge's answer in its store as `call-member-answer`, and ends the
    # turn. On a resume the prompt is the runtime's delivery of the answers, several lines ending
    # at the runtime's last `[call-member]` line; stdin stays open, so it reads up to that line
    # and no further, and answers with the whole prompt on one line, as a turn of its own.
    if [ "$MODE" = "resume" ]; then
      echo "started $SESSION"
      PROMPT="$TASK"
      line="$TASK"
      while :; do
        case "$line" in
          '[call-member] Every call'*|'[call-member] Still working'*) break ;;
        esac
        IFS= read -r line || break
        PROMPT="$PROMPT $line"
      done
      echo "text $PROMPT"
      echo "end $PROMPT"
    else
      unfence_task
      ensure_store
      echo "started $SESSION"
      QUALIFIED="call-member"
      for candidate in ${FIXTURE_BRIDGE_TOOLS//,/ }; do
        case "$candidate" in
          *"__call-member") QUALIFIED="$candidate"; break ;;
        esac
      done
      ARGS='{"member":"worker","task":"Reply with your token and nothing else."}'
      echo "tool c1 $QUALIFIED $ARGS"
      answer="$(call_bridge call-member "$ARGS")"
      printf '%s' "$answer" > "$SESSION_STORE/call-member-answer"
      echo "result c1 ok $answer"
      echo "text waiting"
      echo "end waiting"
    fi
    ;;
  parity)
    # The http capsule's provider script, in harness events: one turn that says something and
    # calls a tool, then one that answers. Its A2A frames must match that capsule's exactly.
    echo "started s1 subscription"
    echo "text working on it"
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"ping\"}"
    answer="$(call_bridge echo-tool '{"msg":"ping"}')"
    echo "result c1 ok $answer"
    echo "text PARITY-ANSWER"
    echo "end PARITY-ANSWER"
    ;;
  tool-progress)
    # `parity`, with the tool call reported while it is being written: its start, then two
    # cumulative sizes, then the complete call. The call's input holds a value nothing else in the
    # run carries, and the bridge is called with the echo tool's default arguments rather than
    # with it, so a test can tell the input apart from the tool's echoed output.
    echo "started s1 subscription"
    echo "text working on it"
    echo "tstart c1 ${FIXTURE_BRIDGE_TOOLS%%,*}"
    echo "tprogress c1 12"
    echo "tprogress c1 40"
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"QXZJ-WKVR-MPLT-YNGH\"}"
    answer="$(call_bridge)"
    echo "result c1 ok $answer"
    echo "text PARITY-ANSWER"
    echo "end PARITY-ANSWER"
    ;;
  tool-progress-large)
    # `tool-progress`, with a 7000-byte input reported in 350 steps of 20 as fast as the harness
    # can print them.
    echo "started s1 subscription"
    echo "text working on it"
    echo "tstart c1 ${FIXTURE_BRIDGE_TOOLS%%,*}"
    for ((i = 1; i <= 350; i++)); do
      echo "tprogress c1 $((i * 20))"
    done
    echo "tool c1 ${FIXTURE_BRIDGE_TOOLS%%,*} {\"msg\":\"ping\"}"
    answer="$(call_bridge)"
    echo "result c1 ok $answer"
    echo "text PARITY-ANSWER"
    echo "end PARITY-ANSWER"
    ;;
  stream)
    # The streaming-driver fixture's three chunks, in harness events.
    echo "started s1 subscription"
    echo "delta chunk_one "
    echo "delta chunk_two "
    echo "delta chunk_three"
    echo "text chunk_one chunk_two chunk_three"
    echo "end chunk_one chunk_two chunk_three"
    ;;
  think)
    echo "started s1 subscription"
    echo "tdelta step "
    echo "tdelta one"
    echo "thinking step one"
    echo "text done"
    echo "end DONE"
    ;;
  think-whole)
    echo "started s1 subscription"
    echo "thinking whole thought"
    echo "text done"
    echo "end DONE"
    ;;
  interrupt-honours)
    # Honours a stdin interrupt: says one thing, then keeps reading stdin and stops the moment the
    # runtime writes the driver's interrupt bytes, reporting the turn the way a stopped harness
    # does. The text goes out before the pid does, so a test that waits for the pid before
    # cancelling is cancelling a turn that has already produced something — which is what keeps
    # the conversation it opened.
    echo "started fixture-session-1"
    echo "text working on it"
    record_pid
    await_interrupt
    ;;
  interrupt-ignores)
    # Never reads its stdin and never stops on its own, so the interrupt grace has to run out and
    # the runtime has to kill it.
    record_pid
    echo "started fixture-session-1"
    pause 600
    ;;
  interrupt-signal)
    # Stops on SIGINT, reporting the turn as canceled before it goes.
    record_pid
    echo "started fixture-session-1"
    trap 'echo "fail canceled interrupted by SIGINT"; kill $SLEEP_PID 2>/dev/null; exit 0' INT
    pause 600 &
    SLEEP_PID=$!
    wait $SLEEP_PID
    ;;
  linger)
    # Prints its terminal event and then ignores stdin closing, so the exit grace has to kill it.
    record_pid
    echo "started fixture-session-1"
    echo "end LINGER"
    pause 60
    ;;
  confinement)
    # What the kernel says this process runs under, into a work-folder file and the answer:
    # seccomp mode, no_new_privs, its pid namespace view, and its network and pid namespaces.
    # `readlink` is a program, so a test running this profile allows it. The listing of
    # $FIXTURE_UNGRANTED, a folder of the host home no grant names, is a glob: empty when the
    # folder is absent or cannot be listed.
    echo "started fixture-session-1"
    {
      while IFS= read -r line; do
        case "$line" in
          Seccomp:*|NoNewPrivs:*|NSpid:*) echo "$line" ;;
        esac
      done < /proc/self/status
      echo "net $(readlink /proc/self/ns/net)"
      echo "pid $(readlink /proc/self/ns/pid)"
      if [ -n "${FIXTURE_UNGRANTED:-}" ]; then
        listing=$(compgen -G "$FIXTURE_UNGRANTED/*")
        echo "ungranted-listing ${listing:-<none>}"
      fi
    } > confinement.txt
    answer=""
    while IFS= read -r line; do answer="$answer$line; "; done < confinement.txt
    echo "text $answer"
    echo "end $answer"
    ;;
  escape)
    # A harness doing its own work, with no bridge: reads a file outside the work folder and
    # every grant (with `cat`, which a test allows), and connects to 1.1.1.1:80 and to a listener
    # on the host's loopback. Each outcome goes into escape.txt and the answer.
    echo "started fixture-session-1"
    if content=$(cat "$FIXTURE_SENTINEL" 2>/dev/null); then
      read_result="OK $content"
    else
      read_result="FAIL"
    fi
    {
      echo "read $read_result"
      echo "tcp-1.1.1.1 $(try_connect 1.1.1.1 80)"
      echo "tcp-host $(try_connect 127.0.0.1 "$FIXTURE_HOST_PORT")"
    } > escape.txt
    answer=""
    while IFS= read -r line; do answer="$answer$line; "; done < escape.txt
    echo "text $answer"
    echo "end $answer"
    ;;
  parent-write)
    # Writes one file in the declared ~/fixture-harness-parent/sessions and one beside it in the
    # parent the manifest granted; the answer says which writes held.
    echo "started fixture-session-1"
    parent="$HOME/fixture-harness-parent"
    if { : > "$parent/sessions/written"; } 2>/dev/null; then inside=OK; else inside=FAIL; fi
    if { : > "$parent/sibling-written"; } 2>/dev/null; then sibling=OK; else sibling=FAIL; fi
    echo "text sessions=$inside sibling=$sibling"
    echo "end sessions=$inside sibling=$sibling"
    ;;
  bridge-hold)
    # Records the bridge URL it was handed in bridge-url.txt, makes one bridged call, writes its
    # answer to bridge-answer.txt, and holds the turn until the test creates `go` in the work
    # folder (sixty seconds at most), so a test can probe the URL's address from the host while
    # the bridge is serving.
    echo "started fixture-session-1"
    answer="$(call_bridge)"
    printf '%s' "$answer" > bridge-answer.txt
    printf '%s' "$FIXTURE_BRIDGE_URL" > bridge-url.txt
    for ((i = 0; i < 600; i++)); do
      [ -e go ] && break
      pause 0.1
    done
    echo "text $answer"
    echo "end $answer"
    ;;
  quota)
    # Two quota reports, each followed by a `session-status` call through the bridge whose answer
    # is kept in status-<n>.answer. The second report replaces five-hour whole and leaves
    # seven-day standing. The pause before each call gives the runtime the moment it takes to
    # read the report; it is the bash builtin, so no PATH is needed.
    echo "started fixture-session-1"
    QUALIFIED=""
    for candidate in ${FIXTURE_BRIDGE_TOOLS//,/ }; do
      case "$candidate" in
        *__session-status) QUALIFIED="$candidate" ;;
      esac
    done
    echo "quota five-hour,used=0.25,resets=1792497600000,minutes=300,state=ok seven-day,used=0.1,minutes=10080"
    read -r -t 1 <> <(:) || true
    echo "tool c1 $QUALIFIED {}"
    printf '%s\n' "$(call_bridge session-status '{}')" > status-1.answer
    echo "result c1 ok status 1"
    echo "quota five-hour,used=0.5,state=warning"
    read -r -t 1 <> <(:) || true
    echo "tool c2 $QUALIFIED {}"
    printf '%s\n' "$(call_bridge session-status '{}')" > status-2.answer
    echo "result c2 ok status 2"
    echo "text QUOTA-RESULT"
    echo "end QUOTA-RESULT"
    ;;
  quota-exhausted)
    # A window reported used up, then an ordinary turn: the runtime must not act on it.
    echo "started fixture-session-1"
    echo "quota five-hour,used=1,state=exhausted"
    echo "text EXHAUSTED-RESULT"
    echo "end EXHAUSTED-RESULT"
    ;;
  late-lines)
    # Ends its turn, waits for the runtime to close stdin, then prints what a harness prints after
    # its result — a quota, a suggestion, a diagnostic — and a late text, answer and usage that
    # must change nothing, then exits 0 inside the exit grace.
    echo "started fixture-session-1"
    echo "usage in=10 out=5"
    echo "text LATE-RESULT"
    echo "end LATE-RESULT"
    while IFS= read -r _; do :; done
    echo "quota five-hour,used=0.5,resets=1792497600000 seven-day,used=0.2"
    echo "suggest run the tests next"
    echo "a diagnostic the harness printed late"
    echo "text LATE-TEXT"
    echo "end LATE-END"
    echo "usage in=9000 out=9000"
    exit 0
    ;;
  late-after-grace)
    # `late-lines`, but its late lines come 5 s after stdin closes: after the 3 s exit grace has
    # killed it, so nothing late is ever printed.
    record_pid
    echo "started fixture-session-1"
    echo "text GRACE-RESULT"
    echo "end GRACE-RESULT"
    while IFS= read -r _; do :; done
    read -r -t 5 <> <(:) || true
    echo "quota five-hour,used=0.9"
    echo "suggest too late"
    exit 0
    ;;
  *)
    echo "fail other unknown profile ${FIXTURE_HARNESS_PROFILE:-}"
    ;;
esac
